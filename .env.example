DATABASE_URL="postgresql://user:password@localhost:5432/wedding_photos"

# Compat\u00edvel com AWS S3 ou Cloudflare R2
S3_REGION="auto"
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_BUCKET="wedding-photos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL="https://fotos.suacdn.com"

# Stripe: use chaves de teste durante o desenvolvimento e configure o webhook
# para /api/billing/webhook ouvindo checkout.session.completed e
# checkout.session.async_payment_succeeded.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
